# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Environments
.venv/
.env

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Research output
results/

# Calibrated models: derived from committed code, a committed configuration and
# the store, like every other result.
artifacts/

# The market data tree: metadata/ is committed configuration and MUST stay
# tracked - it determines past results. Everything the pipeline writes is
# derived from raw/ plus that configuration, and is never committed.
market_data/raw/
market_data/clean/
market_data/validation/
# A transaction mid-flight, or one a crash left behind: never committed.
market_data/.pending/
market_data/.lock

# No data file is committed anywhere. Revisit the day a test needs a binary
# fixture: it would have to be force-added, which is the right amount of
# friction for a file nobody can read in a diff.
*.parquet
*.csv

# OS / editor
.DS_Store
.idea/
.vscode/

# The lock a research journal is appended under: a runtime file, never committed.
*.jsonl.lock

# Figures written by scripts/run_golden_cross_exercise.py
golden_cross_output/

# Figures written by scripts/run_moving_average_band_exercise.py
moving_average_band_output/

# Figures written by scripts/run_moving_average_entry_exit_exercise.py
moving_average_entry_exit_output/

# Figures written by scripts/run_session_segments_study.py
session_segments_output/

# Figures written by scripts/run_rate_regime_study.py
rate_regime_output/
