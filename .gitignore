# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Environments
.venv/
.env

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Research output
results/

# The scaffold's local cache, kept as empty directories.
data/**
!data/**/
!data/**/.gitkeep

# The market data tree: metadata/ is committed configuration and MUST stay
# tracked - it determines past results. Everything the pipeline writes is
# derived from raw/ plus that configuration, and is never committed.
market_data/raw/
market_data/clean/
market_data/validation/
# A transaction mid-flight, or one a crash left behind: never committed.
market_data/.pending/
market_data/.lock

# No data file is committed anywhere. Revisit the day a test needs a binary
# fixture: it would have to be force-added, which is the right amount of
# friction for a file nobody can read in a diff.
*.parquet
*.csv

# OS / editor
.DS_Store
.idea/
.vscode/

# The lock a research journal is appended under: a runtime file, never committed.
*.jsonl.lock
