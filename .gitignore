# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Environments
.venv/
.env

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# What the study scripts export, run after run: raw, large, and reproduced by
# running them. results/ is built from it and is committed.
runs/

# Calibrated models: derived from committed code, a committed configuration and
# the store, like every other result.
artifacts/

# The market data tree: metadata/ is committed configuration and MUST stay
# tracked - it determines past results. Everything the pipeline writes is
# derived from raw/ plus that configuration, and is never committed.
market_data/raw/
market_data/clean/
market_data/validation/
# A transaction mid-flight, or one a crash left behind: never committed.
market_data/.pending/
market_data/.lock

# No market data file is committed anywhere. Revisit the day a test needs a
# binary fixture: it would have to be force-added, which is the right amount of
# friction for a file nobody can read in a diff.
*.parquet
*.csv

# results/: a study commits its reports (every .md), its summary tables, its
# figures and what it froze (selections, their SHA-256, the frozen drivers and
# inputs); a catalogued strategy also keeps its session history and fills,
# which its analysis.md cites. The raw exports of the runs (curves, orders,
# per-candidate folders, caches, manifests) are in an archive attached to a
# GitHub Release, cited by its SHA-256 in results/ARCHIVE.md.
results/**
!results/**/
!results/**/*.md
!results/**/metrics.csv
!results/**/yearly.csv
!results/**/*.png
!results/**/selected.json
!results/**/verdict.json
!results/**/*.sha256
!results/**/*_frozen.json
!results/**/frozen_inputs.json
!results/SA15_GPT-6.1_mechanism_pilot/manifest.json
!results/SA*/history.csv
!results/SA*/fills.csv
!results/summary/**

# OS / editor
.DS_Store
.idea/
.vscode/

